<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    
    @* <title>@ViewData["Title"] - Moviezilla</title> *@
    <title>Moviezilla</title>
    
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/movies-styles.css" asp-append-version="true">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3 main-header">
        <div class="container">
            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/MoviezillaLogo-v2.png" alt="">
            </a>
            @* <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" *@
            @*         aria-expanded="false" aria-label="Toggle navigation"> *@
            @*     <span class="navbar-toggler-icon"></span> *@
            @* </button> *@
            
            @* <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between"> *@
            <ul class="navbar-nav flex-grow-1 gap-4 main-header-left-menu">
                <li class="nav-item">
                    <a class="nav-link @(@ViewData["PageName"]?.ToString() == "Movies" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Movies</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(@ViewData["PageName"]?.ToString() == "Cinemas" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Cinemas</a>
                </li>
            </ul>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-end header-search-container" id="headerSearchContainer">
                    <button class="d-flex align-items-center justify-content-center flex-shrink-0 header-search-toggle" id="headerSearchToggle" aria-label="Open search">
                        <i class="bi bi-search"></i>
                    </button>
                    <input type="text" name="headerSearchInput" class="header-search-input" id="headerSearchInput" placeholder="Search movies, actors or cinemas...">
                </div>
                
                <button class="d-inline-flex align-items-center profile-btn" aria-label="Profile">
                    <i class="bi bi-person-fill"></i>
                </button>
            </div>
            
            @* <partial name="_LoginPartial"/> *@
            @* </div> *@
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Moviezilla - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>