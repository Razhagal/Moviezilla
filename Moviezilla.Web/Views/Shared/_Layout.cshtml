<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3 main-header">
        <div class="container-fluid">
            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/MoviezillaLogo.png" alt="">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 gap-4 main-header-left-menu">
                    <li class="nav-item">
                        <a class="nav-link @(@ViewData["PageName"]?.ToString() == "Movies" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Movies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(@ViewData["PageName"]?.ToString() == "Cinemas" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Cinemas</a>
                    </li>
                </ul>
                @* <partial name="_LoginPartial"/> *@
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Moviezilla.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>